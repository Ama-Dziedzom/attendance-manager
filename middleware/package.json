{
    "name": "attendance-middleware",
    "version": "1.0.0",
    "description": "Middleware server for ZKTeco MB460 terminals - connects terminals to Supabase",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "lint": "eslint src/**/*.ts",
        "simulate": "ts-node scripts/simulate-terminal.ts",
        "test:quick": "ts-node scripts/quick-test.ts",
        "test:health": "ts-node scripts/quick-test.ts health",
        "test:in": "ts-node scripts/quick-test.ts in",
        "test:out": "ts-node scripts/quick-test.ts out"
    },
    "keywords": [
        "zkteco",
        "mb460",
        "attendance",
        "middleware",
        "supabase"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@supabase/supabase-js": "^2.45.0",
        "cors": "^2.8.6",
        "dotenv": "^16.4.5",
        "express": "^4.21.0",
        "socket.io": "^4.7.5",
        "winston": "^3.14.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/node": "^22.0.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.6.0"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
